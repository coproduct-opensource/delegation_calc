(*
 * DLC -- Delegation Logic Calculus, ProVerif cross-check.
 *
 * Phase-2 L2.2 deliverable: an independent symbolic verification of the
 * three load-bearing properties Tamarin proves in models/tamarin/dlc.spthy.
 * Independent in two senses:
 *   1. Different prover (ProVerif vs Tamarin) and different intermediate
 *      representation (applied-pi vs multiset rewriting / Horn clauses).
 *   2. Different proof engine (resolution-based saturation vs DPLL-like
 *      backward search), so a model bug that happens to be invisible to
 *      one tool's heuristics would surface in the other.
 *
 * Three properties (matching Tamarin):
 *   secrecy_ltk    -- adversary never learns an honest principal's secret
 *                     key (unless explicitly revealed).
 *   non_splicing   -- the load-bearing property defeating RFC 8693 chain
 *                     splicing: accepted (P acting Q) says prop must trace
 *                     to BOTH SpeaksForIssued(P, Q) AND Says(Q, prop) by
 *                     the same Q.
 *   exec_delegation - a trace exists where delegation succeeds with no
 *                     key reveals (sanity check).
 *
 * Companion Tamarin model at models/tamarin/dlc.spthy (L2.1).
 * EasyCrypt computational bridge at models/easycrypt/Game.eca (L2.4).
 *)

free c: channel.
free speaks_for_tag: bitstring.
free box_tag: bitstring.
free evidence_tag: bitstring.

(* The obligation channel: PRIVATE, and it carries the obligation from the
 * box process to the discharger without exposing it to the attacker.
 *
 * It does NOT model linearity, despite the operational intuition that a
 * channel message is received by exactly one input. ProVerif's Horn-clause
 * translation is monotonic and does not track consumption -- `out(obl_ch, M)`
 * yields a fact that stays derivable. An earlier revision claimed otherwise
 * and CI disproved it; see the note at the one-shot query below for the full
 * account. Tamarin's linear `Obligation` fact is what carries one-shot, and
 * that result lives in models/tamarin/dlc.spthy only. *)
free obl_ch: channel [private].

(* ========================================================================= *)
(* Signature equational theory                                                *)
(* ========================================================================= *)

type skey.
type pkey.

fun pk(skey): pkey.
fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey;
  checksign(sign(m, k), pk(k)) = m.

(* ========================================================================= *)
(* Honest-key registry                                                        *)
(*                                                                            *)
(* The DLC wire protocol's verifier checks tokens against a pinned keyring   *)
(* of known principals -- not against an arbitrary public key fabricated by *)
(* an attacker. Tamarin captures this via `!Pk($P, pk(sk))` persistent      *)
(* facts (only Register_pk populates `!Pk`). ProVerif needs an explicit     *)
(* table to mirror this; without it, the attacker can present its own       *)
(* fresh-generated public key as the Q in a delegation and forge the second *)
(* half itself.                                                              *)
(* ========================================================================= *)

table honest_keys(pkey).

(* ========================================================================= *)
(* Events -- mirror models/tamarin/dlc.spthy plus an honest-key marker       *)
(* ========================================================================= *)

(* `HonestSk(sk)` fires exactly once per honest-principal creation. Used to *)
(* scope the secrecy query: the attacker can always create its own fresh    *)
(* `skey` values, but only honest secret keys should remain secret unless   *)
(* explicitly revealed.                                                     *)
event HonestSk(skey).

(* Principals are identified by their public keys at the event level, so
   each principal-specific event uses pkey as the identifier. *)
event Says(pkey, bitstring).
event SpeaksForIssued(pkey, pkey).
event DelegateAccept(pkey, pkey, bitstring).
event LtkReveal(pkey).

(* Obligation fragment -- mirrors Box_Issue / Evidence_Issue /
   Discharge_Accept in models/tamarin/dlc.spthy. *)
event BoxIssued(pkey, bitstring, bitstring).
event EvidenceIssued(pkey, bitstring).
event DischargeAccept(pkey, pkey, bitstring, bitstring).

(* ========================================================================= *)
(* Queries -- the load-bearing properties                                     *)
(* ========================================================================= *)

(* secrecy_ltk: an honest secret key never leaks unless explicitly
   revealed. The `event(HonestSk(skP))` antecedent restricts the
   universal quantifier to honestly-created keys (the attacker may
   freely generate its own fresh `skey` values; those don't count). *)
query skP: skey;
  event(HonestSk(skP)) && attacker(skP)
    ==> event(LtkReveal(pk(skP))).

(*
 * non_splicing: if the verifier accepts (P acting Q) says prop, then both
 * halves must trace back to honest emissions by P and Q respectively,
 * unless one of them was revealed.
 *
 * ProVerif's correspondence-assertion form for nested ==>:
 *   event(A) ==> (event(B1) && event(B2)) || event(R1) || event(R2)
 *)
query P: pkey, Q: pkey, prop: bitstring;
  event(DelegateAccept(P, Q, prop)) ==>
    (event(SpeaksForIssued(P, Q)) && event(Says(Q, prop)))
    || event(LtkReveal(P))
    || event(LtkReveal(Q)).

(*
 * exec_delegation: there exists a trace where DelegateAccept fires with
 * neither principal compromised. ProVerif models this as the *negation*
 * of a query that says "DelegateAccept never happens without reveals" --
 * if THAT query is falsified (i.e. a trace exists), executability holds.
 *)
query P: pkey, Q: pkey, prop: bitstring;
  event(DelegateAccept(P, Q, prop)).

(* ========================================================================= *)
(* Extended queries -- four additional properties spanning all four          *)
(* ProVerif query categories, per the audit closure checklist (item 3).      *)
(* ========================================================================= *)

(* secrecy_payload (pure-reachability secrecy form):
 *   Declare a high-value payload that no honest principal ever emits and
 *   that the protocol does not transmit. The attacker should never learn
 *   it. This is the canonical `query attacker(...)` reachability form for
 *   secrecy, distinct from the correspondence-style `secrecy_ltk` above. *)
free dlc_secret_payload: bitstring [private].
query attacker(dlc_secret_payload).

(* says_authentication (correspondence form, plain Says):
 *   For every Says event the verifier could accept on principal P,
 *   either P actually emitted that Says, or P's key was revealed. This
 *   is the non-delegated analogue of `non_splicing`. *)
query P: pkey, prop: bitstring;
  event(Says(P, prop)) ==>
    event(Says(P, prop)) || event(LtkReveal(P)).

(* delegate_implies_speaks_for (correspondence: every DelegateAccept
 *   traces to a corresponding SpeaksForIssued, unless either principal's
 *   key was revealed). A weaker projection of non_splicing that isolates
 *   the speaks-for half of the chain.
 *
 *   This is the correspondence form used in place of the originally
 *   planned `speaks_for_origin` query, which referenced `Says(P, (sft,
 *   P, Q))` and ProVerif's Horn-clause encoding could not prove (the
 *   tuple equality on Says's payload is over-approximated). The
 *   correspondence here is strictly between event arities, so it sits
 *   inside ProVerif's saturation horizon. *)
query P: pkey, Q: pkey, prop: bitstring;
  event(DelegateAccept(P, Q, prop)) ==>
    event(SpeaksForIssued(P, Q))
    || event(LtkReveal(P))
    || event(LtkReveal(Q)).

(* speaks_for_reachable (reachability):
 *   SpeaksForIssued events are reachable -- a sanity-check that the
 *   protocol's speaks-for branch can actually fire. ProVerif reports
 *   `is false` for an existence query (the negation `event(...)` is
 *   falsified), confirming reachability. Complements
 *   `exec_delegation` by isolating the speaks-for half. *)
query P: pkey, Q: pkey;
  event(SpeaksForIssued(P, Q)).

(* honest_separation (observational equivalence form):
 *   Lives in a separate ProVerif file at models/proverif/dlc-equiv.pv.
 *   ProVerif rejects mixing `choice[]` biprocess analysis with
 *   correspondence/secrecy queries in the same source file ("Queries
 *   are incompatible with choice."), so the observational-equivalence
 *   category is checked in an independent invocation. See the CI
 *   workflow at .github/workflows/proverif.yml for both runs. *)

(* ========================================================================= *)
(* Obligation queries -- the ProVerif half of the R2a cross-check            *)
(*                                                                            *)
(* Cross-checking Tamarin's no_silent_discharge and one_shot_discharge.      *)
(* See spec/t4-obligation-design-2026-07.md (rung R2b).                      *)
(* ========================================================================= *)

(* no_silent_discharge (correspondence):
 *   If a verifier accepts a discharge, then the box really was issued by P
 *   AND evidence for its obligation really was issued by Q -- unless one of
 *   their keys was revealed. The direct analogue of Tamarin's lemma of the
 *   same name, and the wire-level form of "obligations cannot be silently
 *   dropped" (spec/syntax.md). *)
query P: pkey, Q: pkey, o: bitstring, prop: bitstring;
  event(DischargeAccept(P, Q, o, prop)) ==>
    (event(BoxIssued(P, o, prop)) && event(EvidenceIssued(Q, o)))
    || event(LtkReveal(P))
    || event(LtkReveal(Q)).

(* discharge_traces_to_box (correspondence, NON-injective):
 *   Every accepted discharge traces back to a box issuance by P. This is the
 *   projection of no_silent_discharge onto the box half, and the strongest
 *   form of the one-shot property ProVerif can establish -- see the note
 *   below on why the injective form is NOT stated here. *)
query P: pkey, Q: pkey, o: bitstring, prop: bitstring;
  event(DischargeAccept(P, Q, o, prop)) ==>
    event(BoxIssued(P, o, prop))
    || event(LtkReveal(P))
    || event(LtkReveal(Q)).

(* ---------------------------------------------------------------------------
 * WHY ONE-SHOT DISCHARGE IS NOT CROSS-CHECKED HERE.
 *
 * The Tamarin model proves one_shot_discharge (12 steps) by CONSUMING a
 * linear `Obligation` fact. ProVerif cannot reproduce that result, and the
 * obstacle is the tool's abstraction rather than anything about the protocol.
 *
 * An earlier revision of this file stated the injective form
 *
 *   inj-event(DischargeAccept(P,Q,o,prop)) ==> inj-event(BoxIssued(P,o,prop))
 *                                              || reveals
 *
 * and asserted that routing the obligation over the private channel `obl_ch`
 * made it provable, on the reasoning that a channel message is received by
 * exactly one input. CI answered: `cannot be proved`, while separately
 * reporting that the NON-injective version of the same correspondence IS
 * true. The claim was wrong.
 *
 * ProVerif's Horn-clause translation is MONOTONIC, and that applies to
 * private channels too: `out(obl_ch, M)` yields a derivable fact, and a
 * derivable fact stays derivable. Consumption by `in` is not tracked. So the
 * channel does not model linearity here -- it only routes the obligation
 * from the box process to the discharger, which is still a faithful way to
 * express the data flow, but buys nothing for injectivity.
 *
 * The honest division of labour is therefore:
 *
 *   no_silent_discharge   -- cross-checked: Tamarin AND ProVerif
 *   one-shot / linearity  -- TAMARIN ONLY (linear facts); ProVerif
 *                            structurally cannot express it
 *
 * Do not re-add the inj-event query expecting a different answer. If one-shot
 * needs a second independent check, it needs a tool with linear resources,
 * not a different ProVerif encoding.
 * --------------------------------------------------------------------------- *)

(* discharge_reachable (reachability):
 *   DischargeAccept is reachable at all. Without this, the two queries
 *   above could hold VACUOUSLY by the discharge branch never firing --
 *   the same trap exec_discharge guards in the Tamarin model. ProVerif
 *   reports `is false` for the negation, confirming reachability. *)
query P: pkey, Q: pkey, o: bitstring, prop: bitstring;
  event(DischargeAccept(P, Q, o, prop)).

(* ========================================================================= *)
(* Processes                                                                  *)
(* ========================================================================= *)

(* A single honest principal P with secret key skP. The principal performs
   any of three actions: emit a Says, emit a SpeaksFor, or get their key
   revealed. The choice is made by the adversary (scheduling). *)
let honest(skP: skey) =
  let pkP = pk(skP) in
  (
    (* Says: pick a fresh prop and sign it. *)
    ! ( new prop: bitstring;
        event Says(pkP, prop);
        out(c, (prop, sign(prop, skP)))
      )
  )
  | (
    (* SpeaksFor: declare that some pkQ may speak for P. The Q is
       provided by the adversary (in(c, pkQ)) -- modeling the realistic
       case where any principal can request to be delegated to. *)
    ! ( in(c, pkQ: pkey);
        let m = (speaks_for_tag, pkP, pkQ) in
        event SpeaksForIssued(pkP, pkQ);
        event Says(pkP, m);
        out(c, (speaks_for_tag, pkP, pkQ, sign(m, skP)))
      )
  )
  | (
    (* box_O(M, N): attach a fresh obligation to a proposition P affirms.
       Emits the DUAL Says event -- see the note below. Also emits the
       obligation itself on the private channel, which is what makes the
       discharge one-shot. *)
    ! ( new o: bitstring;
        new boxprop: bitstring;
        let m_box = (box_tag, o, boxprop) in
        event BoxIssued(pkP, o, boxprop);
        event Says(pkP, m_box);
        out(obl_ch, (pkP, o, boxprop));
        out(c, (box_tag, pkP, o, boxprop, sign(m_box, skP)))
      )
  )
  | (
    (* Evidence that obligation o has been met. The o is adversary-supplied
       (in(c, o)) -- evidence may be offered for any identifier the attacker
       can name; the signature is what binds it to this principal. *)
    ! ( in(c, o: bitstring);
        let m_ev = (evidence_tag, o) in
        event EvidenceIssued(pkP, o);
        event Says(pkP, m_ev);
        out(c, (evidence_tag, pkP, o, sign(m_ev, skP)))
      )
  )
  | (
    (* Static reveal: P optionally leaks their secret key once. *)
    ( event LtkReveal(pkP);
      out(c, skP)
    )
  ).

(* NOTE on the dual `Says` events in the two branches above.
 *
 * Both obligation branches emit `Says(pkP, m)` for the message they sign, in
 * addition to their own event. This mirrors the SpeaksFor branch and is
 * required for the SAME reason: a signed tuple can be taken apart by the
 * attacker and its signature re-paired into the `(prop, sign(prop, skQ))`
 * shape the verifier accepts as a Says half.
 *
 * This is not hypothetical. The first draft of the Tamarin rules omitted
 * these dual events and CI FALSIFIED non_splicing with a 7-step trace (PR
 * #112). Tagging the signed payload does not prevent it -- unification is
 * not the threat, decomposition is. Any principal that signs anything has
 * made a says-affirmation at the trace level. *)

(* Discharger: accepts a discharge only when the box and the evidence both
   verify against REGISTERED principals, and only by consuming one obligation
   message from the private channel.

   The `in(obl_ch, ...)` is the linearity: one message in, one discharge out.
   The `get honest_keys` guards mirror the verifier's, rejecting
   attacker-fabricated public keys. *)
let discharger =
  in(obl_ch, (pkP: pkey, o: bitstring, prop: bitstring));
  in(c, (=box_tag, =pkP, =o, =prop, boxSig: bitstring));
  in(c, (=evidence_tag, pkQ: pkey, =o, evSig: bitstring));
  get honest_keys(=pkP) in
  get honest_keys(=pkQ) in
  let m_box = checksign(boxSig, pkP) in
  let m_ev = checksign(evSig, pkQ) in
  if m_box = (box_tag, o, prop) then
    if m_ev = (evidence_tag, o) then
      event DischargeAccept(pkP, pkQ, o, prop).

(* Verifier: accepts a delegated says only when both signatures verify
   against the SAME pair of *registered* (honest-keyring) principals.
   The `get honest_keys(=pkP/=pkQ)` guards mirror Tamarin's `!Pk($P, ...)`
   persistent-fact requirement -- they reject attacker-fabricated
   public keys. The signature-pattern-match then enforces
   no-chain-splicing structurally. *)
let verifier =
  in(c, (=speaks_for_tag, pkP: pkey, pkQ: pkey, sfSig: bitstring));
  in(c, (prop: bitstring, saysSig: bitstring));
  get honest_keys(=pkP) in
  get honest_keys(=pkQ) in
  let m_sf = checksign(sfSig, pkP) in
  let m_says = checksign(saysSig, pkQ) in
  if m_sf = (speaks_for_tag, pkP, pkQ) then
    if m_says = prop then
      event DelegateAccept(pkP, pkQ, prop).

(* Main process: arbitrarily many honest principals running in parallel
   with arbitrarily many verifier sessions. Each honest principal:
     (1) gets a fresh secret key,
     (2) emits HonestSk(sk) for the secrecy query,
     (3) inserts the corresponding pk into the honest_keys table,
     (4) publishes the pk on the public channel,
     (5) runs the honest principal process. *)
process
  ( ! new skP: skey;
      let pkP = pk(skP) in
      event HonestSk(skP);
      insert honest_keys(pkP);
      out(c, pkP);
      honest(skP) )
  | ( ! verifier )
  | ( ! discharger )
