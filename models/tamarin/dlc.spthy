/*
 * DLC -- Delegation Logic Calculus symbolic model.
 *
 * Tamarin model of the DLC wire protocol. Phase-2 deliverable L2.1
 * (symbolic-model fidelity, per the plan). Three classes of agent action
 * are modeled:
 *
 *   1. Affirmation: principal P produces  <prop, sig_P>  where sig_P =
 *      Sign_{sk(P)}(prop).
 *   2. SpeaksFor:   principal P produces a says-token whose proposition is
 *                   "Q may speak on behalf of P".
 *   3. Delegation:  a verifier accepts (P acting Q) says prop iff it sees
 *                   - a SpeaksFor token from P naming Q
 *                   - a Says token from Q over prop
 *                   against the same pinned public keys.
 *
 * The load-bearing security property is NonSplicing -- exactly the property
 * that defeats the RFC 8693 chain-splicing vulnerability (IETF March-2026
 * thread): if a verifier accepts a delegated claim, both halves of the
 * chain must be the *same* Q. This is enforced structurally by the
 * rule's signature-pattern-match.
 *
 * Adversary model: full Dolev-Yao + static long-term-key reveal. Adaptive
 * corruption is Phase-2-stretch per spec/threat-model.md sec 1.
 *
 * Companion ProVerif cross-check at models/proverif/dlc.pv (L2.2).
 * EasyCrypt computational bridge at models/easycrypt/Game.eca (L2.4).
 */

theory DLC
begin

builtins: signing

// =========================================================================
// Key registration -- each principal P has a long-term Ed25519 keypair
// =========================================================================

// `HonestLtk` is emitted as an ACTION, and it is load-bearing for
// `secrecy_ltk`. Persistent state facts like `!Ltk` are NOT actions and
// cannot appear in a trace formula: a lemma that quantifies over
// `!Ltk(P, sk) @ #j` has an unsatisfiable premise and holds VACUOUSLY.
// See the note on secrecy_ltk below. (models/proverif/dlc.pv already had
// the analogous `HonestSk` event for exactly this reason.)
rule Register_pk:
    [ Fr(~sk) ]
  --[ HonestLtk($P, ~sk) ]->
    [ !Ltk($P, ~sk), !Pk($P, pk(~sk)), Out(pk(~sk)) ]

// Static long-term-key reveal. Models a principal whose secret key is
// disclosed to the adversary at protocol start.
rule Reveal_ltk:
    [ !Ltk($P, sk) ]
  --[ LtkReveal($P) ]->
    [ Out(sk) ]

// =========================================================================
// Says -- principal P signs a proposition (the DLC says-I rule wire form)
// =========================================================================

// The says-I wire form: P signs a fresh proposition. The DLC proof-of-prop
// is abstracted as the proposition itself for the symbolic analysis; the
// proof-term structure is modeled in Lean's Deriv.
rule Says:
    [ Fr(~prop), !Ltk($P, sk) ]
  --[ Says($P, ~prop) ]->
    [ Out(<~prop, sign(~prop, sk)>) ]

// =========================================================================
// SpeaksFor -- principal P signs the proposition "Q speaks for P"
// =========================================================================

// A SpeaksFor token is a particular shape of says: the inner proposition
// declares that Q may act on P's behalf. The 'speaks_for' tag
// distinguishes it from a plain says, but at the trace level it IS a
// says-affirmation, so the rule emits BOTH events.
//
// Without the Says event here, Tamarin finds a self-delegation splice
// where an attacker re-feeds a SpeaksFor output as the Says half of a
// Delegate_Accept (with P = Q). The dual emission closes that gap by
// making SpeaksFor a proper sub-case of Says at the lemma level.
rule SpeaksFor_Issue:
    [ !Ltk($P, sk) ]
  --[
      SpeaksForIssued($P, $Q)
    , Says($P, <'speaks_for', $P, $Q>)
    ]->
    [ Out(<'speaks_for', $P, $Q, sign(<'speaks_for', $P, $Q>, sk)>) ]

// =========================================================================
// Delegate -- verifier accepts (P acting Q) says prop
//
// The rule input patterns enforce no-chain-splicing: both signatures must
// verify against THE SAME pair of principals (P and Q). An attacker
// cannot mix-and-match a SpeaksFor from P->Q with a Says from some other
// q' != Q because the rule pattern requires the same $Q.
// =========================================================================

rule Delegate_Accept:
    [
      // SpeaksFor token by P naming Q
      In(<'speaks_for', $P, $Q, sign(<'speaks_for', $P, $Q>, skP)>)
    , // Says token by Q over the proposition prop
      In(<prop, sign(prop, skQ)>)
    , // The public keys must match the signing keys.
      !Pk($P, pk(skP))
    , !Pk($Q, pk(skQ))
    ]
  --[
      DelegateAccept($P, $Q, prop)
    , UsedSpeaksFor($P, $Q)
    , UsedSays($Q, prop)
    ]->
    [ ]

// =========================================================================
// Obligations -- the box-I / discharge wire forms
// =========================================================================
//
// Added for the T4 non-vacuity ladder (spec/t4-obligation-design-2026-07.md,
// rung R2a). CLAUDE.md requires the Tamarin model to lead any wire-format
// change, so these rules land BEFORE `box_O` reaches dlc-core or wire.rs.
//
// The `box_O(M, N)` wire form: P attaches a fresh obligation ~o to a
// proposition it affirms. The obligation identity is fresh, so distinct
// boxes are distinguishable, and the token is signed so a verifier can
// attribute it.
//
// The signature is over <'box', ~o, ~prop> -- NOT over ~prop alone -- so the
// tag travels inside the signed payload and a verifier can tell a box token
// from a plain affirmation.
//
// NOTE: tagging alone does NOT stop a splice, and an earlier draft of this
// comment wrongly claimed it did (reasoning that the 5-tuple token cannot
// unify with Delegate_Accept's <prop, sign(prop, skQ)> pattern). CI falsified
// non_splicing and showed why that reasoning is wrong -- see below.
//
// Both rules below emit a DUAL `Says` event alongside their own. This is not
// bookkeeping - it is required for soundness, and omitting it falsifies
// `non_splicing`.
//
// Tamarin tuples are transparently decomposable by the adversary, so from a
// token <'box', $P, ~o, ~prop, sign(<'box', ~o, ~prop>, sk)> the adversary can
// project out the signature and re-pair it as <<'box', ~o, ~prop>, sign(...)>
// - which is exactly the shape Delegate_Accept accepts as its Says half. Any
// principal that signs ANYTHING has therefore made a says-affirmation at the
// trace level, and the model must say so.
//
// This is the same failure the SpeaksFor_Issue comment above records Tamarin
// finding. It was rediscovered here the same way: the first draft of these
// rules omitted the dual events and CI falsified non_splicing (verified on
// main, first failure on this branch).
rule Box_Issue:
    [ Fr(~o), Fr(~prop), !Ltk($P, sk) ]
  --[
      BoxIssued($P, ~o, ~prop)
    , Says($P, <'box', ~o, ~prop>)
    ]->
    [ Out(<'box', $P, ~o, ~prop, sign(<'box', ~o, ~prop>, sk)>)
    , Obligation($P, ~o, ~prop)
    ]

// Evidence that an obligation has been met, signed by the discharging party.
//
// `o` is bound by an explicit In(o): evidence may be issued for any obligation
// identifier the adversary can name, but the variable must be BOUND. Leaving
// it free made this rule fail Tamarin's unbound-variable wellformedness check.
rule Evidence_Issue:
    [ In(o), !Ltk($Q, sk) ]
  --[
      EvidenceIssued($Q, o)
    , Says($Q, <'evidence', o>)
    ]->
    [ Out(<'evidence', $Q, o, sign(<'evidence', o>, sk)>) ]

// discharge(M, N): a verifier extracts prop from box_o(prop), given the box
// token and evidence for o.
//
// The rule consumes the LINEAR `Obligation` fact. That fact -- not the wire
// token -- is what carries the one-shot semantics: `Out` messages can be
// replayed by the adversary without limit, so linearity cannot be expressed
// by the token alone. Consuming the fact means a second discharge of the
// same ~o has nothing left to consume, which is what `one_shot_discharge`
// below checks.
rule Discharge_Accept:
    [ Obligation($P, ~o, prop)
    , In(<'box', $P, ~o, prop, sign(<'box', ~o, prop>, skP)>)
    , In(<'evidence', $Q, ~o, sign(<'evidence', ~o>, skQ)>)
    , !Pk($P, pk(skP))
    , !Pk($Q, pk(skQ))
    ]
  --[
      DischargeAccept($P, $Q, ~o, prop)
    , UsedEvidence($Q, ~o)
    ]->
    [ ]

// =========================================================================
// Lemmas -- the four T2-bridging properties from spec/threat-model.md sec 7
// =========================================================================

// Lemma 1 -- Secrecy of long-term keys. The adversary never derives an
// honest principal's secret key (i.e. one that was not explicitly
// revealed via Reveal_ltk).
//
// WAS VACUOUS UNTIL 2026-07-20. The premise read `!Ltk(P, sk) @ #j`, but
// `!Ltk` is a persistent STATE fact -- Register_pk produced it with `-->`,
// emitting no actions at all -- so no rule ever had it as an action. A
// trace formula can only quantify over actions, so the premise was
// unsatisfiable and the implication held for the empty set of traces.
// Tamarin reported `verified (2 steps)`: two steps because it discharged
// the premise immediately, not because the protocol was analysed.
//
// Tamarin DID warn ("Inexistant lemma actions: lemma `secrecy_ltk'
// references action fact "Ltk" ... but no rule has such an action"), but
// the CI gate greps only for `falsified|incomplete`, so a wellformedness
// failure passed silently for the lifetime of the file.
//
// The premise now uses the `HonestLtk` action emitted by Register_pk, so
// the lemma ranges over real traces and has to be earned.
lemma secrecy_ltk:
  all-traces
  "All P sk #i #j.
       KU(sk) @ #i & HonestLtk(P, sk) @ #j
    ==>
       (Ex #r. LtkReveal(P) @ #r)"

// Lemma 2 -- NonSplicing (the load-bearing property).
//
// If the verifier accepts (P acting Q) says prop, then BOTH halves must
// have happened: P issued a SpeaksFor naming Q, AND Q issued a Says over
// prop. No mismatched q' != Q is admissible. Unless one of P or Q was
// revealed.
//
// This is the property that defeats RFC 8693 chain-splicing.
lemma non_splicing:
  all-traces
  "All P Q prop #i.
       DelegateAccept(P, Q, prop) @ #i
    ==>
       ( (Ex #j. SpeaksForIssued(P, Q) @ #j & j < i)
       & (Ex #k. Says(Q, prop) @ #k & k < i) )
       | (Ex #r. LtkReveal(P) @ #r & r < i)
       | (Ex #r. LtkReveal(Q) @ #r & r < i)"

// Lemma 3 -- Executability sanity check.
//
// A trace exists where a delegation is accepted with no key reveals.
// If this lemma fails, the model has a structural defect that prevents
// the protocol from running at all.
lemma exec_delegation:
  exists-trace
  "Ex P Q prop #i.
       DelegateAccept(P, Q, prop) @ #i
     & not (Ex #r. LtkReveal(P) @ #r)
     & not (Ex #r. LtkReveal(Q) @ #r)"

// Lemma 4 -- NoSilentDischarge.
//
// If a verifier extracts prop from a boxed proof, then the box really was
// issued by P AND evidence for its obligation really was issued by Q. An
// obligation cannot be dropped in transit -- the wire-level counterpart of
// spec/syntax.md's "obligations cannot be silently dropped".
lemma no_silent_discharge:
  all-traces
  "All P Q o prop #i.
       DischargeAccept(P, Q, o, prop) @ #i
    ==>
       ( (Ex #j. BoxIssued(P, o, prop) @ #j & j < i)
       & (Ex #k. EvidenceIssued(Q, o) @ #k & k < i) )
       | (Ex #r. LtkReveal(P) @ #r & r < i)
       | (Ex #r. LtkReveal(Q) @ #r & r < i)"

// Lemma 5 -- OneShotDischarge (linearity).
//
// The same obligation cannot be discharged twice. This is the protocol-level
// counterpart of the spec's "O is linear" side condition (typing-rules.md
// sec 8), and the wire-level shadow of the multiset accounting T4 will state
// in Lean. It holds structurally because Discharge_Accept consumes the
// linear `Obligation` fact; if that fact were made persistent (!Obligation)
// this lemma should FAIL, which is the check that it is load-bearing.
lemma one_shot_discharge:
  all-traces
  "All P Q1 Q2 o prop1 prop2 #i #j.
       DischargeAccept(P, Q1, o, prop1) @ #i
     & DischargeAccept(P, Q2, o, prop2) @ #j
    ==>
       #i = #j"

// Lemma 6 -- Executability sanity check for the obligation fragment.
//
// A trace exists where an obligation is issued and discharged with no key
// reveals. Without this, lemmas 4 and 5 could both hold vacuously by the
// discharge rule simply never firing.
lemma exec_discharge:
  exists-trace
  "Ex P Q o prop #i.
       DischargeAccept(P, Q, o, prop) @ #i
     & not (Ex #r. LtkReveal(P) @ #r)
     & not (Ex #r. LtkReveal(Q) @ #r)"

end
