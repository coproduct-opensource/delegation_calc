// =========================================================================
// dlcd-viewchange-byz.spthy — BOUNDED liveness past a BYZANTINE (equivocating) leader
// =========================================================================
//
// Phase 4 (spec/bft-liveness-design.md §4-§5). Strengthens dlcd-viewchange.spthy
// from a CRASH-fault (silent) leader to a BYZANTINE one: the initial leader
// EQUIVOCATES — proposes two DIFFERENT values in the same view — and is replaced
// by a quorum view-change, after which a correct leader drives a decision.
// n = 4, quorum = 3 (2f+1, f=1) — the standard BFT sizing (n = 3f+1); prior art:
// equivocation = a Byzantine leader proposing multiple blocks for one view
// (decentralizedthoughts / HotStuff family); Tamarin for BFT (Recipe,
// arXiv 2502.09251).
//
// =========================================================================
// HONEST FENCE — read before citing this
// =========================================================================
// The liveness lemma is an EXISTS-TRACE: it shows progress is REACHABLE (POSSIBLE)
// once the view rotates off the equivocating leader — NOT the temporal ◇ "always
// eventually decides" (that needs a fair-scheduling model-checker, TLA+/TLC — the
// deeper artifact, spec §4). `no_two_decisions` is the all-traces SAFETY companion:
// agreement survives the equivocating leader + rotation, tolerating f=1 Byzantine
// (two conflicting decisions would require TWO compromised keys, i.e. f+1 > f).

theory DLCD_ViewChange_Byz
begin

builtins: signing

// =========================================================================
// Restrictions
// =========================================================================

restriction Equality:
  "All x y #i. Eq(x, y) @ #i ==> x = y"

restriction Inequality:
  "All x y #i. Neq(x, y) @ #i ==> not(x = y)"

restriction unique_key:
  "All A #i #j. KeyRegistered(A) @ #i & KeyRegistered(A) @ #j ==> #i = #j"

// One vote per (replica, view) — the linear heart of quorum intersection.
restriction unique_vote_open:
  "All R v #i #j. VoteOpened(R, v) @ #i & VoteOpened(R, v) @ #j ==> #i = #j"

// The fixed roster of FOUR (n = 3f+1 for f = 1). Only these can open a vote, so a
// quorum of 3 intersects any other quorum of 3 in at least two replicas.
restriction roster:
  "All R v #i. VoteOpened(R, v) @ #i
     ==> (R = 'r1') | (R = 'r2') | (R = 'r3') | (R = 'r4')"

// =========================================================================
// Keys and compromise
// =========================================================================

rule Register_key:
    [ Fr(~sk) ]
  --[ HonestKey($A, ~sk), KeyRegistered($A) ]->
    [ !Ltk($A, ~sk), !Pk($A, pk(~sk)), Out(pk(~sk)) ]

rule Reveal_ltk:
    [ !Ltk($A, sk) ]
  --[ Reveal($A) ]->
    [ Out(sk) ]

// =========================================================================
// The protocol
// =========================================================================

rule Setup_views:
    [ ]
  --[ ViewLeader('v0', $L0), ViewLeader('v1', $L1), Neq($L0, $L1) ]->
    [ !View('v0', $L0), !View('v1', $L1) ]

rule Open_vote:
    [ ]
  --[ VoteOpened($R, $v) ]->
    [ VoteToken($R, $v) ]

// The leader of view v proposes a value, signed. A BYZANTINE leader may fire this
// MORE THAN ONCE for one view with different values — equivocation.
rule Propose:
    [ !View($v, $L), !Ltk($L, skL) ]
  --[ Proposed($L, $v, $val) ]->
    [ Out(<'propose', $v, $val, sign(<'propose', $v, $val>, skL)>) ]

rule Timeout:
    [ !Ltk($R, skR) ]
  --[ TimedOut($R, $vfrom) ]->
    [ Out(<'vc', $R, $vfrom, sign(<'vc', $vfrom>, skR)>) ]

// A view-change CERTIFICATE: a quorum (THREE distinct replicas) of signed timeouts.
rule ViewChange:
    [ In(<'vc', $R1, vfrom, s1>)
    , In(<'vc', $R2, vfrom, s2>)
    , In(<'vc', $R3, vfrom, s3>)
    , !Pk($R1, pk1), !Pk($R2, pk2), !Pk($R3, pk3)
    ]
  --[ Eq(verify(s1, <'vc', vfrom>, pk1), true)
    , Eq(verify(s2, <'vc', vfrom>, pk2), true)
    , Eq(verify(s3, <'vc', vfrom>, pk3), true)
    , Neq($R1, $R2), Neq($R1, $R3), Neq($R2, $R3)
    , ViewChangeCert(vfrom)
    ]->
    [ ]

// A replica votes for a proposal in view v (spends its one token, checks the
// leader's signature).
rule Vote:
    [ VoteToken($R, $v)
    , In(<'propose', $v, val, psig>)
    , !View($v, $L)
    , !Pk($L, pkL)
    , !Ltk($R, skR)
    ]
  --[ Eq(verify(psig, <'propose', $v, val>, pkL), true)
    , Voted($R, $v, val)
    ]->
    [ Out(<'vote', $R, $v, val, sign(<'vote', $v, val>, skR)>) ]

// A value is DECIDED in view v when a quorum (THREE distinct replicas) voted for it.
rule Decide:
    [ In(<'vote', $R1, $v, val, s1>)
    , In(<'vote', $R2, $v, val, s2>)
    , In(<'vote', $R3, $v, val, s3>)
    , !Pk($R1, pk1), !Pk($R2, pk2), !Pk($R3, pk3)
    ]
  --[ Eq(verify(s1, <'vote', $v, val>, pk1), true)
    , Eq(verify(s2, <'vote', $v, val>, pk2), true)
    , Eq(verify(s3, <'vote', $v, val>, pk3), true)
    , Neq($R1, $R2), Neq($R1, $R3), Neq($R2, $R3)
    , Decided($v, val)
    ]->
    [ ]

// =========================================================================
// Lemmas
// =========================================================================

// BOUNDED LIVENESS past a BYZANTINE leader (exists-trace). A decision is REACHABLE
// in view 'v1' AFTER a quorum view-change abandoned 'v0', in a run where 'v0's
// leader EQUIVOCATED (proposed two DIFFERENT values a ≠ b in v0) and NO key was
// revealed. NON-VACUOUS by the equivocation clause: the decision genuinely came
// from the rotation off a Byzantine leader, not from that leader's own proposal.
lemma progress_after_byzantine_viewchange_reachable:
  exists-trace
  "Ex L0 a b val #s #e1 #e2 #vc #d.
       ViewLeader('v0', L0) @ #s
     & Proposed(L0, 'v0', a) @ #e1
     & Proposed(L0, 'v0', b) @ #e2
     & not (a = b)
     & ViewChangeCert('v0') @ #vc
     & Decided('v1', val) @ #d
     & #vc < #d
     & not (Ex X #r. Reveal(X) @ #r)"

// SAFETY UNDER A BYZANTINE LEADER + ROTATION (all-traces). Agreement survives the
// equivocating leader: no two conflicting values are decided in one view unless a
// key leaked. With NO compromise, two conflicting decisions would need two quorums
// of 3 over the roster of 4 — six distinct honest voters, but only four exist and
// none double-votes (`double_vote_needs_reveal`) — so it is impossible.
//
// HONEST FENCE: this escape is "unless SOME key leaked" (≥1 reveal), the same form
// the crash model proves. The TIGHT f=1 Byzantine bound — that TWO distinct keys
// (f+1) must leak — is true by quorum intersection (two 3-of-4 quorums overlap in
// ≥2 honest replicas) but is NOT machine-proved here: it needs a two-distinct
// (`X ≠ Y`) counting argument Tamarin's heuristics do not complete automatically
// (the same disequality limitation noted in the interop/replication models). So we
// state the proven form and fence the tighter bound.
lemma no_two_decisions:
  all-traces
  "All v c1 c2 #i #j.
       Decided(v, c1) @ #i & Decided(v, c2) @ #j
    ==>
       c1 = c2
     | (Ex X #r. Reveal(X) @ #r)"

// ANTI-EQUIVOCATION AT THE VOTER (all-traces). No honest replica backs two
// different values in one view — the linear vote-token (`unique_vote_open`) defeats
// an equivocating leader's attempt to split an honest replica's vote. This is the
// per-voter core the quorum argument above rests on.
lemma double_vote_needs_reveal:
  all-traces
  "All R v a b #i #j.
       Voted(R, v, a) @ #i & Voted(R, v, b) @ #j
    ==> a = b | (Ex X #r. Reveal(X) @ #r)"

end
